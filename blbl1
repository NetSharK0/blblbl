UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    local isKey = false
    
    -- Vérifier si c'est la touche ² / ` / Backquote
    if input.KeyCode == Enum.KeyCode.Backquote then
        isKey = true
    end
    
    -- Alternative : touche "²" sur clavier AZERTY
    if not isKey then
        local keyName = input.KeyCode.Name
        if keyName == "Quote" or keyName == "Backquote" then
            isKey = true
        end
    end
    
    if isKey then
        if traderName and traderName ~= "" then
            -- 📋 Copier dans le presse-papier
            pcall(function()
                if setclipboard then
                    setclipboard(traderName)
                elseif game:GetService("GuiService").SetClipboard then
                    game:GetService("GuiService"):SetClipboard(traderName)
                end
            end)
            
            -- 🎯 Mettre le nom dans le champ Partner
            pcall(function()
                if PartnerUserBox then
                    PartnerUserBox.Text = traderName
                end
                if TradeTable and TradeTable.Player2 then
                    TradeTable.Player2.Player = traderName
                end
            end)
            
            -- Notification
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "✅ Copié & Partner mis à jour",
                    Text = traderName,
                    Duration = 4
                })
            end)
            
            -- Status
            if statusLabel then
                statusLabel.Text = "📋 Copié & Partner: " .. traderName
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
                task.delay(3, function()
                    if statusLabel then
                        statusLabel.Text = "🔵 Ready"
                        statusLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
                    end
                end)
            end
        else
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "❌ Aucun trader",
                    Text = "Ouvre un trade ou attends",
                    Duration = 3
                })
            end)
            
            if statusLabel then
                statusLabel.Text = "❌ Aucun trader"
                statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.delay(2, function()
                    if statusLabel then
                        statusLabel.Text = "🔵 Ready"
                        statusLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
                    end
                end)
            end
        end
    end
end)

