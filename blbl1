local function FakeTrade()
    pcall(function()
        if Config.in_trade then
            if statusLabel then
                statusLabel.Text = "⚠️ Already in trade"
                statusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            end
            return
        end
        
        local partnerName = PartnerUserBox.Text
        if partnerName == "" or partnerName == nil then
            partnerName = "DevShark10"
        end
        
        TradeTable.Player2.Player = partnerName
        TradeTable.Player2.Offer = {}
        TradeTable.Player2.Accepted = false
        TradeTable.Player1.Accepted = false
        TradeTable.Player1.Offer = {}
        
        StartTrade()
        
        if statusLabel then
            statusLabel.Text = "🎭 Trade opened with: " .. partnerName
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 255)
        end
    end)
end

local function AcceptOffer()
    pcall(function()
        if not Config.in_trade then
            if statusLabel then
                statusLabel.Text = "⚠️ No open trade"
                statusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            end
            return
        end
        
        if not next(TradeTable["Player1"]["Offer"]) and not next(TradeTable["Player2"]["Offer"]) then
            if statusLabel then
                statusLabel.Text = "⚠️ No items in offer!"
                statusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            end
            return
        end
        
        if v84 then
            if statusLabel then
                statusLabel.Text = "⏳ Cooldown active!"
                statusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            end
            return
        end
        
        TheirOffer.Accepted.Visible = true
        TradeTable["Player2"]["Accepted"] = true
        AcceptTrade()
        
        if statusLabel then
            statusLabel.Text = "✅ Trade accepted!"
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
        end
    end)
end

