local Keys = {
    FakeTrade = "C",
    AcceptOffer = "V",
    RandomName = "B",
    RandomWeapon = "X"
}

local function CreateKeyConfigRow(label, defaultKey, parent, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundTransparency = 1
    row.Parent = parent
    
    local labelFrame = Instance.new("Frame")
    labelFrame.Size = UDim2.new(0.55, 0, 1, 0)
    labelFrame.BackgroundTransparency = 1
    labelFrame.Parent = row
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(1, 0, 1, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.Font = Enum.Font.SourceSansSemibold
    labelText.TextSize = 11
    labelText.TextColor3 = Color3.fromRGB(200, 200, 220)
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.Parent = labelFrame
    
    local keyBox = Instance.new("TextBox")
    keyBox.Size = UDim2.new(0.35, 0, 1, 0)
    keyBox.Position = UDim2.new(0.6, 0, 0, 0)
    keyBox.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    keyBox.BackgroundTransparency = 0.2
    keyBox.Text = defaultKey
    keyBox.Font = Enum.Font.SourceSans
    keyBox.TextSize = 13
    keyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    keyBox.ClearTextOnFocus = false
    keyBox.TextXAlignment = Enum.TextXAlignment.Center
    keyBox.Parent = row
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = keyBox
    
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = Color3.fromRGB(100, 100, 255)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.3
    stroke.Parent = keyBox
    
    keyBox.FocusLost:Connect(function()
        local newKey = string.upper(string.sub(keyBox.Text, 1, 1))
        if newKey:match("^[A-Z]$") then
            local conflict = false
            for action, key in pairs(Keys) do
                if key == newKey and action ~= callback.action then
                    conflict = true
                    break
                end
            end
            
            if conflict then
                keyBox.Text = defaultKey
                keyBox.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.delay(1, function()
                    keyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
                end)
                return
            end
            
            Keys[callback.action] = newKey
            keyBox.Text = newKey
            keyBox.TextColor3 = Color3.fromRGB(0, 255, 100)
            task.delay(1, function()
                keyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            end)
            
            if statusLabel then
                statusLabel.Text = "⌨️ " .. label .. " → " .. newKey
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
                task.delay(2, function()
                    if statusLabel then
                        statusLabel.Text = "🔵 Ready"
                        statusLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
                    end
                end)
            end
        else
            keyBox.Text = defaultKey
            keyBox.TextColor3 = Color3.fromRGB(255, 100, 100)
            task.delay(1, function()
                keyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            end)
        end
    end)
    
    return row
end

