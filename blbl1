--  23. FONCTIONNALITÉ : COPIER LE NOM DU TRADER + SET PARTNER (²)
-- ============================================================

local traderName = nil

local function ResetTrader()
    traderName = nil
end

local function GetTraderFromUI()
    local foundName = nil
    
    pcall(function()
        if TheirOffer and TheirOffer:FindFirstChild("Username") then
            local text = TheirOffer.Username.Text
            if text and text ~= "" then
                -- Extraire entre parenthèses
                local startPos, endPos = string.find(text, "%(([^)]+)%)")
                if startPos and endPos then
                    local name = string.sub(text, startPos + 1, endPos - 1)
                    if name and name ~= "" then
                        foundName = name
                    end
                else
                    -- Nettoyer le texte
                    local cleanName = text:gsub("[()]", ""):gsub("^%s+", ""):gsub("%s+$", "")
                    if cleanName and cleanName ~= "" then
                        foundName = cleanName
                    end
                end
            end
        end
    end)
    
    if not foundName then
        pcall(function()
            if TradeTable and TradeTable.Player2 and TradeTable.Player2.Player then
                local name = TradeTable.Player2.Player
                if name and name ~= "" and name ~= "DevShark10" then
                    foundName = name
                end
            end
        end)
    end
    
    if foundName then
        traderName = foundName
    end
    
    return foundName
end

local function WatchTraderChanges()
    pcall(function()
        if TheirOffer and TheirOffer:FindFirstChild("Username") then
            local usernameLabel = TheirOffer.Username
            usernameLabel:GetPropertyChangedSignal("Text"):Connect(function()
                ResetTrader()
                GetTraderFromUI()
            end)
        end
    end)
    
    pcall(function()
        if TradeGUI then
            TradeGUI:GetPropertyChangedSignal("Enabled"):Connect(function()
                if TradeGUI.Enabled then
                    ResetTrader()
                    task.wait(0.3)
                    GetTraderFromUI()
                else
                    ResetTrader()
                end
            end)
        end
    end)
end

local function hookTradeRemotes()
    pcall(function()
        for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
            local nameLower = remote.Name:lower()
            if remote:IsA("RemoteEvent") and (nameLower:find("trade") or nameLower:find("offer") or nameLower:find("partner") or nameLower:find("start")) then
                remote.OnClientEvent:Connect(function(...)
                    ResetTrader()
                    local args = {...}
                    for _, arg in ipairs(args) do
                        if typeof(arg) == "string" and #arg >= 3 and #arg <= 20 then
                            local plr = Players:FindFirstChild(arg)
                            if plr and plr ~= game.Players.LocalPlayer then
                                traderName = plr.Name
                                return
                            end
                        end
                    end
                    task.wait(0.2)
                    GetTraderFromUI()
                end)
            end
        end
    end)
end

